# WXT ContextCanon - example environment.
# Copy to .env if you use the Docker path. Nothing here is a real secret and
# every value is localhost / synthetic.

# --- Profile Core ---
WXT_CONTEXTCANON_PROFILE_HOST=127.0.0.1
WXT_CONTEXTCANON_PROFILE_PORT=8611
WXT_CONTEXTCANON_PROFILE_DATABASE=./data/profile.db
WXT_CONTEXTCANON_PROFILE_DATA_DIR=./data

# --- Registry Core ---
WXT_CONTEXTCANON_REGISTRY_DEVICE_ID=demo-device
WXT_CONTEXTCANON_REGISTRY_DEVICE_ROLE=primary
WXT_CONTEXTCANON_REGISTRY_HOME=./data/registry
WXT_CONTEXTCANON_REGISTRY_SHARED_STORE=./data/registry/shared.db

# --- Release Guard ---
WXT_CONTEXTCANON_DEPLOY_PROJECT_NAME=wxt-contextcanon
WXT_CONTEXTCANON_DEPLOY_TRANSPORT=local-shell
WXT_CONTEXTCANON_DEPLOY_LOCK_PATH=./data/deploy.lock
